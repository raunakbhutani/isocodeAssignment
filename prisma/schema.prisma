generator client {
  provider = "prisma-client-js"
}

model LeadAssignmentCursor {
  showroomId String
  modelId    String
  nextIndex  Int      @default(0)
  showroom   Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  model      CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@id([showroomId, modelId])
}

model LeadNotification {
  id                    String               @id @default(cuid())
  leadId                String
  recipientConsultantId String?
  type                  LeadNotificationType
  message               String
  readAt                DateTime?
  createdAt             DateTime             @default(now())
  lead                  Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientConsultant   Consultant?          @relation(fields: [recipientConsultantId], references: [id], onDelete: SetNull)

  @@index([recipientConsultantId, readAt, createdAt])
  @@index([leadId, createdAt])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  BUYER
  CONSULTANT
  ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleType {
  NEW
  USED
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum PriceType {
  EX_SHOWROOM
  LISTING_PRICE
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATION
  TEST_DRIVE_SCHEDULED
  CONVERTED
  LOST
}

enum LeadNotificationType {
  LEAD_ASSIGNED
  LEAD_UNASSIGNED
  LEAD_REASSIGNED
}

enum LeadAiStatus {
  GENERATED
  UNAVAILABLE
  MANUAL
}

enum LeadSource {
  WEBSITE
  CAR_PORTAL
  SOCIAL_AD
  WALK_IN
  TEST_DRIVE
  OTHER
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum TestDriveBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ConsentType {
  CONTACT
  MARKETING
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String?
  emailVerified     DateTime?
  image             String?
  role              UserRole           @default(BUYER)
  isActive          Boolean            @default(true)
  isDemo            Boolean            @default(false)
  accounts          Account[]
  sessions          Session[]
  consultant        Consultant?
  buyerLeads        Lead[]             @relation("BuyerLead")
  leadActivities    LeadActivity[]     @relation("LeadActivityActor")
  madeAssignments   LeadAssignment[]   @relation("AssignmentActor")
  consentRecords    ConsentRecord[]
  testDriveBookings TestDriveBooking[] @relation("BookingBuyer")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CarModel {
  id                String                 @id @default(cuid())
  brand             String
  name              String
  variants          CarVariant[]
  consultants       ConsultantModel[]
  assignmentCursors LeadAssignmentCursor[]
  assignments       LeadAssignment[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([brand, name])
}

model CarVariant {
  id         String             @id @default(cuid())
  modelId    String
  name       String
  fuel       FuelType
  model      CarModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  inventory  VehicleInventory[]
  cityPrices CityPrice[]
  leads      Lead[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([modelId, name])
  @@index([modelId, fuel])
}

model VehicleInventory {
  stockId           String          @id
  type              VehicleType
  variantId         String
  year              Int
  kilometres        Int
  priceInr          Int?
  priceType         PriceType
  status            VehicleStatus
  isDemo            Boolean         @default(false)
  previousOwners    Int?
  inspectionReport  String?
  detailsAreAssumed Boolean         @default(false)
  showroomId        String?
  variant           CarVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  showroom          Showroom?       @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  images            VehicleImage[]
  demoSlots         TestDriveSlot[]
  leads             Lead[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([type, status])
  @@index([variantId, status])
}

model City {
  id        String      @id @default(cuid())
  name      String
  state     String
  country   String      @default("India")
  showrooms Showroom[]
  prices    CityPrice[]
  leads     Lead[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([name, state, country])
}

model CityPrice {
  id                 String     @id @default(cuid())
  cityId             String
  variantId          String
  exShowroomPriceInr Int
  roadTaxBasisPoints Int
  registrationFeeInr Int
  insuranceInr       Int
  accessoriesInr     Int
  otherChargesInr    Int        @default(0)
  isAssumed          Boolean    @default(false)
  effectiveFrom      DateTime
  effectiveUntil     DateTime?
  city               City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  variant            CarVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([cityId, variantId, effectiveFrom])
  @@index([cityId, variantId, effectiveUntil])
}

model VehicleImage {
  id             String           @id @default(cuid())
  vehicleStockId String
  url            String
  altText        String
  sortOrder      Int              @default(0)
  isAssumed      Boolean          @default(false)
  vehicle        VehicleInventory @relation(fields: [vehicleStockId], references: [stockId], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([vehicleStockId, sortOrder])
}

model Showroom {
  id                    String                 @id @default(cuid())
  name                  String
  address               String?
  cityId                String
  isAssumed             Boolean                @default(false)
  isActive              Boolean                @default(true)
  city                  City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  consultant            Consultant[]
  inventory             VehicleInventory[]
  slots                 TestDriveSlot[]
  leads                 Lead[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  leadAssignmentCursors LeadAssignmentCursor[]
  leadAssignments       LeadAssignment[]

  @@unique([name, cityId])
  @@index([cityId, isActive])
}

model Consultant {
  id            String             @id @default(cuid())
  userId        String             @unique
  showroomId    String
  isActive      Boolean            @default(true)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  showroom      Showroom           @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  leads         Lead[]             @relation("LeadAssignee")
  assignments   LeadAssignment[]
  models        ConsultantModel[]
  notifications LeadNotification[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([showroomId, isActive])
}

model ConsultantModel {
  consultantId String
  modelId      String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  model        CarModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([consultantId, modelId])
  @@index([modelId, consultantId])
}

model Lead {
  id                   String             @id @default(cuid())
  reference            String             @unique
  buyerUserId          String?
  customerName         String
  email                String?
  phone                String
  message              String?
  budgetInr            Int?
  purchaseTimeline     String?
  source               LeadSource
  status               LeadStatus         @default(NEW)
  variantId            String?
  vehicleStockId       String?
  cityId               String?
  requestedShowroomId  String?
  assignedConsultantId String?
  receivedAt           DateTime           @default(now())
  assignedAt           DateTime?
  firstRespondedAt     DateTime?
  buyer                User?              @relation("BuyerLead", fields: [buyerUserId], references: [id], onDelete: SetNull)
  assignedConsultant   Consultant?        @relation("LeadAssignee", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  variant              CarVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  vehicle              VehicleInventory?  @relation(fields: [vehicleStockId], references: [stockId], onDelete: SetNull)
  city                 City?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  requestedShowroom    Showroom?          @relation(fields: [requestedShowroomId], references: [id], onDelete: SetNull)
  assignments          LeadAssignment[]
  activities           LeadActivity[]
  aiDrafts             LeadAiDraft[]
  testDriveBookings    TestDriveBooking[]
  consentRecords       ConsentRecord[]
  notifications        LeadNotification[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([assignedConsultantId, status, receivedAt])
  @@index([status, receivedAt])
  @@index([source, receivedAt])
}

model LeadAssignment {
  id           String     @id @default(cuid())
  leadId       String
  consultantId String
  showroomId   String?
  modelId      String?
  assignedById String?
  assignedAt   DateTime   @default(now())
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  showroom     Showroom?  @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  model        CarModel?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  assignedBy   User?      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([leadId, assignedAt])
  @@index([consultantId, assignedAt])
}

model TestDriveSlot {
  id                 String            @id @default(cuid())
  showroomId         String
  demoVehicleStockId String
  startsAt           DateTime
  endsAt             DateTime
  isOpen             Boolean           @default(true)
  showroom           Showroom          @relation(fields: [showroomId], references: [id], onDelete: Restrict)
  demoVehicle        VehicleInventory  @relation(fields: [demoVehicleStockId], references: [stockId], onDelete: Restrict)
  booking            TestDriveBooking?
  createdAt          DateTime          @default(now())

  @@unique([demoVehicleStockId, startsAt])
  @@index([showroomId, startsAt, isOpen])
}

model TestDriveBooking {
  id          String                 @id @default(cuid())
  leadId      String
  slotId      String                 @unique
  buyerUserId String?
  status      TestDriveBookingStatus @default(REQUESTED)
  lead        Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  slot        TestDriveSlot          @relation(fields: [slotId], references: [id], onDelete: Restrict)
  buyer       User?                  @relation("BookingBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([leadId, status])
}

model ConsentRecord {
  id         String      @id @default(cuid())
  userId     String?
  leadId     String?
  type       ConsentType
  granted    Boolean
  source     String
  recordedAt DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@index([leadId, type, recordedAt])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  actorUserId String?
  type        LeadActivityType
  details     String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor       User?            @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
}

model LeadAiDraft {
  id            String       @id @default(cuid())
  leadId        String
  summary       String
  summaryData   Json?
  replyDraft    String
  model         String
  status        LeadAiStatus @default(MANUAL)
  statusMessage String?
  reviewedAt    DateTime?
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([leadId, createdAt])
}
