generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  CONSULTANT
  ADMIN
}

enum LocationType {
  SHOWROOM
  SERVICE_WORKSHOP
  USED_CAR_YARD
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleType {
  NEW
  USED
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum PriceBasis {
  EX_SHOWROOM
  LISTING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  TEST_DRIVE_SCHEDULED
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  CAR_PORTAL
  SOCIAL_AD
  WALK_IN
  TEST_DRIVE
  OTHER
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum TestDriveBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(BUYER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  assignedLeads  Lead[]   @relation("LeadAssignee")
  createdLeads   Lead[]   @relation("BuyerLead")
  leadActivities LeadActivity[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model City {
  id           String              @id @default(cuid())
  name         String
  state        String
  country      String              @default("India")
  locations    Location[]
  pricingRules CityPricingRule[]
  leads        Lead[]

  @@unique([name, state, country])
}

model Location {
  id         String       @id @default(cuid())
  name       String
  type       LocationType
  address    String?
  cityId     String
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  city          City                 @relation(fields: [cityId], references: [id])
  vehicles      VehicleStock[]
  testDriveSlots TestDriveSlot[]
  leads         Lead[]

  @@index([cityId, type, isActive])
}

model VehicleModel {
  id        String    @id @default(cuid())
  brand     String
  name      String
  variants  Variant[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([brand, name])
}

model Variant {
  id           String        @id @default(cuid())
  modelId      String
  name         String
  fuel         FuelType
  model        VehicleModel  @relation(fields: [modelId], references: [id])
  stock        VehicleStock[]
  pricingRules CityPricingRule[]
  leads        Lead[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([modelId, name])
}

model VehicleStock {
  stockId       String        @id
  type          VehicleType
  variantId     String
  year          Int
  kilometres    Int
  priceInr      Int
  priceBasis    PriceBasis
  status        VehicleStatus
  locationId    String?
  variant       Variant       @relation(fields: [variantId], references: [id])
  location      Location?     @relation(fields: [locationId], references: [id])
  demoSlots     TestDriveSlot[]
  leads         Lead[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type, status])
  @@index([variantId, status])
}

model CityPricingRule {
  id                          String   @id @default(cuid())
  cityId                      String
  variantId                   String
  roadTaxBasisPoints           Int
  registrationFeeInr           Int
  insuranceInr                 Int
  otherChargesInr              Int      @default(0)
  effectiveFrom                DateTime
  effectiveUntil               DateTime?
  city                          City     @relation(fields: [cityId], references: [id])
  variant                       Variant  @relation(fields: [variantId], references: [id])
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([cityId, variantId, effectiveFrom])
  @@index([cityId, variantId, effectiveUntil])
}

model TestDriveSlot {
  id                  String    @id @default(cuid())
  locationId          String
  demoVehicleStockId  String
  startsAt            DateTime
  endsAt              DateTime
  isOpen              Boolean   @default(true)
  location            Location  @relation(fields: [locationId], references: [id])
  demoVehicle         VehicleStock @relation(fields: [demoVehicleStockId], references: [stockId])
  booking             TestDriveBooking?
  createdAt           DateTime  @default(now())

  @@unique([demoVehicleStockId, startsAt])
  @@index([locationId, startsAt, isOpen])
}

model TestDriveBooking {
  id          String                  @id @default(cuid())
  leadId      String
  slotId      String                  @unique
  status      TestDriveBookingStatus  @default(REQUESTED)
  lead        Lead                    @relation(fields: [leadId], references: [id])
  slot        TestDriveSlot           @relation(fields: [slotId], references: [id])
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([leadId, status])
}

model Lead {
  id                       String      @id @default(cuid())
  reference                String      @unique
  buyerUserId              String?
  customerName             String
  email                    String?
  phone                    String
  source                   LeadSource
  status                   LeadStatus  @default(NEW)
  variantId                String?
  vehicleStockId           String?
  cityId                   String?
  requestedLocationId      String?
  assignedConsultantId     String?
  receivedAt               DateTime    @default(now())
  assignedAt               DateTime?
  firstRespondedAt         DateTime?
  buyerConsentAt           DateTime?
  buyer                    User?       @relation("BuyerLead", fields: [buyerUserId], references: [id])
  assignedConsultant      User?        @relation("LeadAssignee", fields: [assignedConsultantId], references: [id])
  variant                  Variant?    @relation(fields: [variantId], references: [id])
  vehicleStock             VehicleStock? @relation(fields: [vehicleStockId], references: [stockId])
  city                     City?       @relation(fields: [cityId], references: [id])
  requestedLocation        Location?   @relation(fields: [requestedLocationId], references: [id])
  activities               LeadActivity[]
  aiDrafts                 LeadAiDraft[]
  testDriveBookings        TestDriveBooking[]
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([assignedConsultantId, status, receivedAt])
  @@index([status, receivedAt])
  @@index([source, receivedAt])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  actorUserId String?
  type        LeadActivityType
  details     String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor       User?            @relation(fields: [actorUserId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
}

model LeadAiDraft {
  id          String    @id @default(cuid())
  leadId      String
  summary     String
  replyDraft  String
  model       String
  reviewedAt  DateTime?
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([leadId, createdAt])
}
